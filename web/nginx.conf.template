# nginx.conf.template - per-session token gate for apps with no native
# URL-token auth. Rendered by web/token-gate.sh with envsubst; ${OSP_APP_PORT},
# ${OSP_APP_BIND}, ${OSP_APP_TOKEN}, ${OSP_APP_TOKEN_NAME}, ${OSP_APP_SOCK_DIR},
# ${OSP_APP_HEALTH_PATH} and ${NGINX_DIR} are substituted, every other
# $variable is nginx's own.
#
# Runs entirely unprivileged: no `user` directive (that one needs root), a
# listen port >= 1024, and every writable path under ${NGINX_DIR}, inside the
# session's private directory, because the .sif filesystem is read-only.
#
# This is the only TCP listener in the session. Behind it the app is a Unix
# socket, ${OSP_APP_SOCK_DIR}/app.sock: a loopback TCP port would be reachable
# by every other process on the node, token or no token.

worker_processes  1;
daemon            off;
pid               ${NGINX_DIR}/nginx.pid;
# stderr, which the supervisor relays into the job's output with a prefix.
error_log         stderr warn;

events {
    worker_connections  1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    # The default `combined` format logs $request, which includes the query
    # string -- and the first request of every session carries the token in it.
    # Log the path only, so the secret is never written to disk.
    log_format gated '$remote_addr [$time_local] '
                     '"$request_method $uri $server_protocol" '
                     '$status $body_bytes_sent';
    access_log            ${NGINX_DIR}/access.log gated;
    client_body_temp_path ${NGINX_DIR}/body;
    proxy_temp_path       ${NGINX_DIR}/proxy;
    fastcgi_temp_path     ${NGINX_DIR}/fastcgi;
    uwsgi_temp_path       ${NGINX_DIR}/uwsgi;
    scgi_temp_path        ${NGINX_DIR}/scgi;

    sendfile             on;
    server_tokens        off;    # no nginx version on error pages
    client_max_body_size 0;      # data files move through here; don't cap them

    # WebSocket upgrade plumbing. noVNC, JupyterLab terminals and RStudio all
    # depend on this; without it the page loads and then silently does nothing.
    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    # --- the gate ----------------------------------------------------------
    # Two ways in: the token as a query parameter (the link Satellite hands the
    # user) or the cookie we set in exchange for it on that first request.
    map $arg_${OSP_APP_TOKEN_NAME} $token_in_query {
        '${OSP_APP_TOKEN}' 1;
        default        0;
    }
    map $cookie_${OSP_APP_TOKEN_NAME} $token_in_cookie {
        '${OSP_APP_TOKEN}' 1;
        default        0;
    }
    map "$token_in_query:$token_in_cookie" $gate {
        '1:0'   exchange;    # valid token in the URL, no cookie yet
        '1:1'   pass;
        '0:1'   pass;
        default deny;
    }

    # The app, on a Unix socket in the session's private directory.
    upstream osp_app {
        server unix:${OSP_APP_SOCK_DIR}/app.sock;
    }

    server {
        # Loopback by default (OSP_APP_BIND): the launcher's reverse SSH
        # tunnel connects here, and nothing else needs to.
        listen       ${OSP_APP_BIND}:${OSP_APP_PORT} default_server;
        server_name  _;
        default_type text/plain;    # only affects pages nginx itself returns

        # Satellite speaks https to the browser and http to us. Left on,
        # nginx would build redirects as http://<host>:<port>/ from OUR
        # scheme and port and send the browser somewhere that does not exist.
        # Relative Location headers resolve against the browser's origin.
        absolute_redirect off;

        # Readiness, for the launcher: "ok" with 200 once the app answers 2xx
        # for OSP_APP_HEALTH_PATH on its socket, 503 before that. Ungated, so
        # the app's own response never reaches the caller: auth_request makes
        # the upstream request as a subrequest and keeps only its status, and
        # the 200 body is a fixed file (a `return` would answer before the
        # check ran). This says the upstream is serving, not that the desktop
        # is usable; the supervisor ends the session if any part of it dies.
        location = /healthz {
            access_log   off;
            auth_request /_osp_upstream_ready;
            error_page   401 403 500 =503 @unhealthy;
            default_type text/plain;
            alias        ${NGINX_DIR}/healthz.ok;
        }
        location = /_osp_upstream_ready {
            internal;
            proxy_pass              http://osp_app/${OSP_APP_HEALTH_PATH};
            proxy_pass_request_body off;
            proxy_set_header        Content-Length "";
        }
        location @unhealthy {
            return 503;
        }

        location / {
            # Trade the query-string token for a cookie, then redirect to the
            # same path without it -- so the secret stops travelling in URLs,
            # browser history and Referer headers after the first hop.
            if ($gate = exchange) {
                add_header Set-Cookie "${OSP_APP_TOKEN_NAME}=${OSP_APP_TOKEN}; Path=/; HttpOnly; SameSite=Lax; Secure" always;
                return 302 $uri;
            }

            # A bare 403: nothing that tells the reader how to get in.
            if ($gate = deny) {
                return 403;
            }

            proxy_pass http://osp_app;

            # Every proxy_set_header lives here, in one block. nginx inherits
            # proxy_set_header from an enclosing level ONLY when the current
            # level defines none, so splitting them between server{} and
            # location{} silently drops the server-level ones.
            #
            # Satellite terminates TLS and proxies plain HTTP to us. Apps that
            # build their own absolute URLs or websocket endpoints need to be
            # told the browser is speaking https.
            proxy_http_version 1.1;
            proxy_set_header   Host              $host;
            proxy_set_header   X-Real-IP         $remote_addr;
            proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header   X-Forwarded-Proto https;
            proxy_set_header   X-Forwarded-Host  $host;
            proxy_set_header   Upgrade           $http_upgrade;
            proxy_set_header   Connection        $connection_upgrade;

            # Interactive sessions are long-lived and stream; don't buffer them
            # and don't time the websocket out after the default 60s.
            proxy_buffering    off;
            proxy_read_timeout 86400s;
            proxy_send_timeout 86400s;
        }
    }
}
